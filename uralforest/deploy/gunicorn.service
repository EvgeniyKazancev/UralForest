[Unit]
Description=Uralforest — сайт пиломатериалов (Django + Gunicorn)
After=network.target

[Service]
User=__APP_USER__
Group=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__APP_DIR__/.env
ExecStart=__APP_DIR__/.venv/bin/gunicorn uralforest.wsgi:application \
    --bind 127.0.0.1:__PORT__ \
    --workers 3 \
    --timeout 60 \
    --access-logfile - \
    --error-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
