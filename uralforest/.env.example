# --- Основные настройки ---
# Секретный ключ Django (сгенерируйте новый для продакшена!)
DJANGO_SECRET_KEY=django-insecure-change-me-in-production-uralforest-2026
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Для домена на продакшене, например: DJANGO_CSRF_TRUSTED_ORIGINS=https://ваш-домен.рф

# --- База данных (по умолчанию SQLite; для продакшена можно PostgreSQL) ---
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=uralforest
# DB_USER=postgres
# DB_PASSWORD=secret
# DB_HOST=127.0.0.1
# DB_PORT=5432

# --- Оплата: ЮKassa ---
# Получите Shop ID и секретный ключ в личном кабинете https://yookassa.ru
# Пока PAYMENTS_ENABLED=False — работает демонстрационная оплата.
PAYMENTS_ENABLED=False
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Куда вернуть пользователя после оплаты (на продакшене укажите домен)
YOOKASSA_RETURN_URL=

# --- Почта (опционально; по умолчанию письма выводятся в консоль) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.yandex.ru
# EMAIL_PORT=465
# EMAIL_HOST_USER=Ural_forest@bk.ru
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
ORDERS_NOTIFY_EMAIL=Ural_forest@bk.ru
DEFAULT_FROM_EMAIL=Ural_forest@bk.ru
